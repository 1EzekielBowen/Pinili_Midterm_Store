@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Products</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal">
        + Add New Product
    </button>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products yet. Add your first product to get started.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="product-img">
                        @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                    </div>
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category</span>
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted">@item.Description</p>
                        <p class="fs-5 fw-bold mb-0">@item.Price.ToString("C")</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                            <input type="hidden" name="productId" value="@item.Id" />
                            <button type="submit" class="btn btn-success w-100">Add to Cart</button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Products" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addProductLabel">Add Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" id="Name" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <input type="text" id="Description" name="Description" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="Price" class="form-label">Price</label>
                        <input type="number" id="Price" name="Price" class="form-control" step="0.01" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label for="Category" class="form-label">Category</label>
                        <input type="text" id="Category" name="Category" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>